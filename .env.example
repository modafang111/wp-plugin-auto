# ============================================================
# base-wp-ja-auto 環境変数
# このファイルを .env にコピーし、値を記入してください。
# パスワード・APIキーをソースコードへ書かないこと。
# .env は Git にコミットしないこと。
# ============================================================

# --- 安全運転 ---
# true の間は BASE へ実登録しない。登録予定内容だけ生成する。
DRY_RUN=true

# draft=非表示(visible=0) / public=表示(visible=1)
# 初回は draft を推奨。管理画面確認後に public へ。
BASE_PUBLISH_MODE=draft

# 公式 language pack がある、または完了率が SKIP_IF_JA_PERCENT 以上でも処理を続けるか
# 日本語サイトでは WordPress が公式パックを自動ダウンロードするため、
# パックがあるプラグインは入れるだけで日本語になる。販売対象外が安全。
CONTINUE_IF_ALREADY_TRANSLATED=false

# 公式日本語翻訳がこのパーセント以上なら「販売する意味が薄い」と判定
# 公式 language pack がある場合はパーセントに関係なくスキップする。
SKIP_IF_JA_PERCENT=95

# ============================================================
# BASE ショップアカウント（thebase.com から進める場合。これが本線）
# ============================================================
# サービス入口:     https://thebase.com/
# 管理画面ログイン: https://admin.thebase.com/users/login
# 2023年3月に thebase.in から thebase.com へ移行済み。
# ショップ開設時に使うのはメールアドレスとパスワード。
# Developers の client_id などは、この画面からは発行されない。

BASE_LOGIN_EMAIL=
BASE_LOGIN_PASSWORD=
BASE_ADMIN_URL=https://admin.thebase.com/users/login

# 既存の販売商品（テンプレート。参照専用。変更・削除しない）
# 公開商品ページの例:
#   https://123789.theshop.jp/items/55749997
#   https://あなたのショップ.base.shop/items/12345678
BASE_TEMPLATE_PRODUCT_URL=
BASE_TEMPLATE_PRODUCT_ID=

# テンプレート商品が対象にしていたプラグイン名。説明文差し替え精度が上がる。
BASE_TEMPLATE_PLUGIN_NAME=
BASE_TEMPLATE_PLUGIN_VERSION=

# ショップの公開URL（商品URL生成に使う。末尾スラッシュなし）
# 例: https://123789.theshop.jp  /  https://yourshop.base.shop
SHOP_PUBLIC_BASE_URL=

# デジタルファイルを Playwright で管理画面へ載せるか。
# true かつ「デジタルコンテンツ」メニューがある場合に添付を試みる。
# メニューが無いショップでは非公開の通常商品登録だけ行う。
BASE_UPLOAD_DIGITAL_FILE=false

# 生成した商品画像を Playwright で載せるか。
BASE_UPLOAD_GENERATED_IMAGE=false

# wordpress_icon | generated | template | skip
BASE_IMAGE_MODE=wordpress_icon

# 管理画面ブラウザ。クラウドやサーバでは true。手元確認だけ false。
PLAYWRIGHT_HEADLESS=true

# 生成した商品画像を Playwright で載せるか。
BASE_UPLOAD_GENERATED_IMAGE=false

# wordpress_icon | generated | template | skip
BASE_IMAGE_MODE=wordpress_icon

# ============================================================
# BASE 公式API（任意。thebase.com のショップログインだけでは不要）
# ============================================================
# ショップオーナーが必ず申請するものではない。
# 使う場合だけ https://developers.thebase.com/ でアプリ申請する。
# 必要な scope: read_users read_items write_items
# APIの通信先は現在も https://api.thebase.in/ （公式ドキュメント準拠）
# 未設定なら、商品メタデータのAPI登録は行わず DRY RUN / 要確認になる。

BASE_CLIENT_ID=
BASE_CLIENT_SECRET=
BASE_REDIRECT_URI=https://localhost/callback
BASE_ACCESS_TOKEN=
BASE_REFRESH_TOKEN=

# ============================================================
# 商品情報（テンプレート未取得時の安全なデフォルト。テンプレート優先）
# ============================================================
# {plugin_name} {version} を差し込み可能。ソースへ命名規則を固定しない。
PRODUCT_NAME_PATTERN={plugin_name} WordPressプラグイン 日本語化ファイル
PRODUCT_PRICE=
PRODUCT_STOCK=9999
PRODUCT_TAX_TYPE=1
BASE_CATEGORY_ID=

# translation_only = 翻訳ファイル+README のみ
# plugin_and_translation = プラグイン本体も含める（非推奨。内部では必ず分離保存）
SALE_PACKAGE_MODE=translation_only

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# openai | offline_glossary
# 本番は openai。キー未設定かつ DRY_RUN の検証時のみ offline_glossary を許可。
# キー名は OPENAI_API_KEY。AI_API_KEY という項目名は使わない。
TRANSLATION_PROVIDER=openai
TRANSLATION_BATCH_SIZE=25

# --- メール通知 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail の場合は通常のログインパスワードではなく「アプリパスワード」(16文字) を使う。
# 表示が「xxxx xxxx xxxx xxxx」でも、スペース付きのままでよい。
SMTP_USE_TLS=true
NOTIFY_EMAIL=
MAIL_FROM=

# メール未設定でも処理を止めない（DRY_RUN 向け）。本番は true 推奨。
REQUIRE_EMAIL=false

# ============================================================
# 売れたあとの自動お届け（通常商品向け）
# ============================================================
# 公式の自動ダウンロードは Apps「デジタルコンテンツ販売」を入れて
# 商品をデジタルコンテンツとして登録した場合だけ有効。
# https://apps.thebase.com/detail/20
# App 未導入のショップでは python app.py --deliver-orders が
# 未対応注文の購入者へ *-ja.zip をメールする。
DELIVERY_MARK_DISPATCHED=true
DELIVERY_POLL_SECONDS=300
DELIVERY_LOOKBACK_DAYS=90
DELIVERY_MAX_ZIP_BYTES=20971520

# --- 制限 ---
MAX_ZIP_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=209715200
MAX_ZIP_FILES=8000
HTTP_TIMEOUT_SECONDS=60
