# ソフト横断の通知メール設定。
# 実ファイルは Git に入れない。次のいずれかに置く:
#   %USERPROFILE%\.config\notify-mail.env
#   D:\dev\.env.notify
#   D:\dev\cloud-agent-sync\notify.local.json
# または環境変数 NOTIFY_MAIL_ENV にフルパスを入れる。
#
# 他の Python ソフトからは:
#   import sys
#   sys.path.insert(0, r"D:\dev")
#   from notify_mail_env import apply_shared_notify_env
#   apply_shared_notify_env()

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail は通常のログインパスワードではなく「アプリパスワード」(16文字)。
# 表示が「xxxx xxxx xxxx xxxx」でも、スペース付きのままでよい。
SMTP_USE_TLS=true
NOTIFY_EMAIL=
MAIL_FROM=
